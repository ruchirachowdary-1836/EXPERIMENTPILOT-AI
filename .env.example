# Copy to backend/.env (all optional; shown with defaults)
EP_DATABASE_URL=sqlite:///./data/experimentpilot.db
# PostgreSQL: EP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/experimentpilot   (pip install psycopg[binary])
EP_DATA_DIR=./data
EP_MAX_UPLOAD_MB=25
EP_MAX_ROWS=200000
EP_MAX_COLUMNS=500
EP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EP_EXECUTOR=process
EP_EXPERIMENT_TIMEOUT_S=180
EP_BENCHMARK_WORKERS=2
EP_ENVIRONMENT=local
EP_EXPOSE_DOCS=true
# Frontend dev proxy target (frontend/.env.local)
# VITE_API_TARGET=http://127.0.0.1:8000
